[Unit]
Description=Sequential native dependency vulnerability scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/diab/Dev/xbot/.venv/bin/python /home/diab/ops/vps-security/libexec/native_healthcheck_wrapper.py --component native --config /home/diab/.config/vps-security-scan/native.json -- /home/diab/Dev/xbot/.venv/bin/python /home/diab/ops/vps-security/libexec/native_scanner.py --config /home/diab/.config/vps-security-scan/native.json
TimeoutStartSec=26min
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
Nice=10
CPUQuota=25%
MemoryMax=1G
IOWeight=50
TasksMax=128
