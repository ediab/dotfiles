[Unit]
Description=Email if the daily running-image scan becomes stale

[Service]
Type=oneshot
ExecStart=%h/Dev/xbot/.venv/bin/python %h/ops/vps-security/libexec/healthcheck_wrapper.py --component watchdog --config %h/.config/vps-security-scan/config.json -- %h/Dev/xbot/.venv/bin/python %h/ops/vps-security/libexec/job_watchdog.py --config %h/.config/vps-security-scan/config.json
TimeoutStartSec=40s
UMask=0077
NoNewPrivileges=yes
