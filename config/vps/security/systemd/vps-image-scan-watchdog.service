[Unit]
Description=Email if the daily running-image scan becomes stale

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/ops/vps-security/libexec/healthcheck_wrapper.py --component watchdog --config %h/.config/vps-security-scan/config.json -- /usr/bin/python3 %h/ops/vps-security/libexec/job_watchdog.py --config %h/.config/vps-security-scan/config.json
TimeoutStartSec=40s
UMask=0077
NoNewPrivileges=yes
