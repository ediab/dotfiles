[Unit]
Description=Sequential vulnerability scan of exact running container images
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/ops/vps-security/libexec/healthcheck_wrapper.py --component scan --config %h/.config/vps-security-scan/config.json -- /usr/bin/python3 %h/ops/vps-security/libexec/scanner.py --config %h/.config/vps-security-scan/config.json
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=yes
Nice=10
CPUQuota=50%
MemoryMax=2G
IOWeight=100
