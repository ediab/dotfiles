{
  // ==========================================
  // --- UI: minimal chrome, Zed-style ---
  // ==========================================
  "workbench.iconTheme": "symbols",
  "workbench.colorTheme": "Catppuccin Mocha",
  "window.titleBarStyle": "native",
  "window.commandCenter": false, // one less bar of chrome up top
  "workbench.panel.showLabels": false,
  "workbench.editor.labelFormat": "short",
  "workbench.editor.highlightModifiedTabs": true, // dot on tabs with unsaved changes
  "workbench.editor.limit.enabled": true, // caps open tabs, auto-closes the oldest
  "workbench.editor.limit.value": 8,
  "extensions.ignoreRecommendations": true, // no "you should install X" nudges
  "update.showReleaseNotes": false, // no release-notes tab after every update
  "telemetry.telemetryLevel": "off", // no telemetry — minimal setups leak this default
  "workbench.tips.enabled": false, // kill the "Tip of the Day" popup
  "zenMode.hideStatusBar": true,
  "zenMode.hideActivityBar": true,
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": false,
  "workbench.activityBar.location": "top", // icon column collapses into a bar above the explorer, instead of its own column
  "workbench.sideBar.location": "left",
  "workbench.startupEditor": "none",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.layoutControl.enabled": false,
  "window.title": "${activeEditorMedium}${separator}${rootName}${separator}${activeRepositoryBranchName}${dirty}",
  "explorer.openEditors.visible": 1, // max rows the Open Editors pane shows before scrolling; to hide the pane entirely, right-click the Explorer header and uncheck it
  "workbench.statusBar.visible": false, // removes the bottom bar completely
  "chat.disableAIFeatures": true, // hides and disables built-in Chat / Copilot features
  "breadcrumbs.enabled": false, // Zed has no breadcrumb trail; reclaim the vertical space
  "editor.stickyScroll.enabled": false, // no floating header bar over the code
  "editor.minimap.enabled": false,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.hideCursorInOverviewRuler": true,
  "workbench.colorCustomizations": {
    "statusBar.border": "#00000000",
    "sideBar.border": "#00000000",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorGroup.border": "#00000000",
    "panel.border": "#00000000",
    "editorRuler.foreground": "#313244" // dim the 88/100 rulers (Catppuccin Mocha surface0) so they're a quiet guide, not bright red
  },
  // ==========================================
  // --- Typography: Maple Mono ---
  // ==========================================
  // Requires the NF (Nerd Font) build for ligatures + terminal/powerline glyphs:
  //   brew install --cask font-maple-mono-nf
  // "editor.fontFamily": "'Maple Mono NF', 'JetBrains Mono', Menlo, monospace",
  // "editor.fontLigatures": true,
  // "editor.fontSize": 13,
  // "editor.lineHeight": 1.6,
  // "editor.cursorBlinking": "smooth",
  // "editor.cursorStyle": "line",
  "editor.cursorWidth": 3,
  "editor.smoothScrolling": true,
  // 1. Font Family & Ligatures
  "editor.fontFamily": "'Maple Mono NF', 'Maple Mono', monospace",
  "editor.fontLigatures": "'calt', 'zero'",
  "editor.fontWeight": "400",
  // 2. Sizing, Spacing & Proportions
  "editor.fontSize": 14,
  "editor.lineHeight": 24,
  "editor.letterSpacing": 0.3,
  // 3. Smooth Motion & Rendering
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.fontVariations": true,
  // 4. Force Cursive Italics for Comments & Keywords
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "keyword",
          "storage.type",
          "entity.other.attribute-name",
          "variable.language"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  // ==========================================
  // --- Editor behavior & file sync ---
  // ==========================================
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnSaveTimeout": 5000,
  "editor.formatOnPaste": true, // pasted code runs through your formatter too
  "editor.lineNumbers": "interval", // only every 10th line — quieter gutter, still a sense of where you are
  "editor.renderWhitespace": "selection",
  "editor.rulers": [
    88,
    100
  ],
  "editor.wordWrap": "on",
  "editor.scrollBeyondLastLine": false,
  "editor.overviewRulerBorder": false, // drop the hairline separating the overview ruler from the gutter
  "editor.scrollbar.vertical": "auto", // scrollbar slides out when idle — harmonic with smoothScrolling
  "editor.scrollbar.horizontal": "auto",
  "editor.inlayHints.enabled": "offUnlessPressed",
  // NOT "afterDelay": that mode skips formatOnSave and codeActionsOnSave (ruff fixAll /
  // organizeImports below) unless you save explicitly. onFocusChange runs them every time.
  "files.autoSave": "onFocusChange",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.autoCheckConfigFileChanges": true,
  // ==========================================
  // --- Explorer, search & diffs ---
  // ==========================================
  "explorer.compactFolders": true, // flattens single-child folders into one line, like Zed's project panel
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.excludeGitIgnore": true,
  "workbench.tree.renderIndentGuides": "none", // no faint vertical guide lines in the explorer tree
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/node_modules/**": true
  },
  // ==========================================
  // --- Python ---
  // ==========================================
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.autoSearchPaths": true,
  "python.analysis.diagnosticMode": "workspace",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "always",
      "source.organizeImports.ruff": "always"
    }
  },
  // ==========================================
  // --- Jupyter Notebooks ---
  // ==========================================
  "notebook.output.textLineLimit": 100,
  "notebook.showCellStatusbar": true,
  "notebook.formatOnSave.enabled": true,
  "notebook.lineNumbers": "on",
  // ==========================================
  // --- Git ---
  // ==========================================
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.untrackedChanges": "separate",
  "git.autorefresh": true,
  // ==========================================
  // --- Terminal (you live here, so this section is tuned for it) ---
  // ==========================================
  "terminal.integrated.fontFamily": "'Maple Mono NF', Menlo, Monaco, monospace",
  "terminal.integrated.scrollback": 50000,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.enableMultiLinePasteWarning": "auto", // only warns in shells without bracketed paste; set "never" to silence it everywhere
  "terminal.integrated.defaultLocation": "view",
  "workbench.panel.defaultLocation": "right",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "args": [
        "-l"
      ],
      "icon": "terminal"
    }
  },
  "terminal.integrated.defaultProfile.osx": "zsh",
  // ==========================================
  // --- Remote & misc integrations ---
  // ==========================================
  "remote.SSH.connectTimeout": 300,
  "remote.SSH.useLocalServer": true,
  "chat.mcp.gallery.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "window.customTitleBarVisibility": "never" // likely inert while window.titleBarStyle is "native" — kept for if you ever switch to "custom"
}
