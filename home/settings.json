{
  "lastChangelogVersion": "0.87.1",
  "theme": "terminal",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high",
  "tuiMode": "fullscreen",
  "externalEditor": "druk",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@ff-labs/pi-fff",
    "npm:pi-code-previews",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "!ponytail",
        "+skills/ponytail/SKILL.md",
        "-skills/ponytail-debt/SKILL.md",
        "-skills/ponytail-gain/SKILL.md"
      ]
    },
    "npm:@tintinweb/pi-subagents",
    "npm:@tintinweb/pi-tasks",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-terminal-theme",
    "npm:@juicesharp/rpiv-advisor",
    "git:github.com/earendil-works/pi-review",
    "npm:@andrewjacop/pi-herdr",
    "npm:omp-codex-reserve",
    {
      "source": "npm:@lnilluv/pi-opencode-go-rotation@1.5.3",
      "extensions": [
        "+dist/index.js"
      ]
    },
    "npm:@narumitw/pi-btw",
    "npm:pi-open-tui",
    "npm:pi-rtk-optimizer",
    "npm:pi-observational-memory",
    "npm:pi-extmgr"
  ],
  "skills": [
    "!**/.agents/skills/use-tinyfish",
    "!**/.agents/skills/simplify",
    "-skills/simplify/SKILL.md",
    "-skills/use-tinyfish/SKILL.md",
    "-skills/ATTRIBUTION.md",
    "-skills/pull-financial-data/SKILL.md"
  ],
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "steeringMode": "all",
  "followUpMode": "all",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "editorPaddingX": 1,
  "outputPad": 1,
  "markdown": {
    "mermaid": "streaming"
  },
  "observational-memory": {
    "showWorkerNotifications": true
  },
  "showCacheMissNotices": false,
  "enabledModels": [
    "deepseek/deepseek-flash",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-reserve",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/mimo-v2.6-flash",
    "opencode-go/mimo-v2.6-pro",
    "opencode-go/glm-5.3",
    "opencode-go/glm-5.3-flash",
    "opencode-go/grok-4.6",
    "opencode-go/grok-4.7",
    "opencode-go/muse-spark-1.3-contributor",
    "opencode-go/omen-alpha",
    "commandcode/deepseek/deepseek-v4.1-flash",
    "commandcode/xiaomi/mimo-v2.6-flash",
    "commandcode/xiaomi/mimo-v2.6-pro",
    "commandcode/zai-org/GLM-5.3",
    "commandcode/z-ai/glm-5.3-flash",
    "commandcode/xai/grok-4.6",
    "commandcode/xai/grok-4.7",
    "commandcode/meta/muse-spark-1.3-contributor"
  ]
}