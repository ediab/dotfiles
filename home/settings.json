{
  "lastChangelogVersion": "0.86.1",
  "theme": "terminal",
  "defaultProvider": "opencode-go",
  "defaultModel": "muse-spark-1.3-contributor",
  "defaultThinkingLevel": "high",
  "tuiMode": "fullscreen",
  "externalEditor": "druk",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:@ff-labs/pi-fff",
    "npm:pi-code-previews",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "!ponytail",
        "+skills/ponytail/SKILL.md"
      ]
    },
    "npm:@tintinweb/pi-subagents",
    "npm:@tintinweb/pi-tasks",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "https://github.com/cathrynlavery/diagram-design",
      "skills": [
        "-skills/diagram-design/SKILL.md"
      ],
      "prompts": [
        "-prompts/doctor.md",
        "-prompts/export-diagram.md",
        "-prompts/import-excalidraw.md",
        "-prompts/import-mermaid.md",
        "-prompts/profile.md"
      ]
    },
    {
      "source": "npm:pi-zentui",
      "extensions": [
        "-extensions/zentui/index.ts"
      ]
    },
    "npm:pi-terminal-theme",
    "npm:@juicesharp/rpiv-advisor",
    "npm:pi-intercom",
    "git:github.com/earendil-works/pi-review",
    "npm:pi-commandcode-provider",
    "npm:@andrewjacop/pi-herdr",
    "npm:@lll9p/pi-better-compaction",
    "https://github.com/ayghri/i-have-adhd",
    "npm:omp-codex-reserve",
    {
      "source": "npm:@lnilluv/pi-opencode-go-rotation@1.5.3",
      "extensions": [
        "+dist/index.js"
      ]
    },
    "npm:pi-updater",
    "npm:pi-opener",
    {
      "source": "npm:pi-codex-goal",
      "prompts": [
        "+prompts/create-goal.md"
      ]
    },
    "npm:@narumitw/pi-btw"
  ],
  "skills": [
    "!**/.agents/skills/use-tinyfish",
    "!**/.agents/skills/simplify",
    "-skills/simplify/SKILL.md",
    "-skills/use-tinyfish/SKILL.md"
  ],
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "quietStartup": true,
  "hideThinkingBlock": true
}