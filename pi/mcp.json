{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "!sed -n 's/^CONTEXT7_API_KEY=//p' \"$HOME/.env\""
      },
      "exposure": "codemode"
    },
    "lightpanda": {
      "command": "~/.local/bin/lightpanda",
      "args": ["mcp", "--obey-robots"],
      "env": {
        "LIGHTPANDA_DISABLE_TELEMETRY": "true",
        "LIGHTPANDA_DISABLE_CORE_DUMP": "true"
      },
      "exposure": "codemode",
      "description": "Browse JavaScript-powered websites, extract page content, and interact with forms."
    }
  }
}
