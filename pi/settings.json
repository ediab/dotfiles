  "hideThinkingBlock": true,
  "editorPaddingX": 1,
  "outputPad": 1,
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "deviceId": "4867752c-ac6b-43a5-85b4-aeada0361eaf",
  "lastChangelogVersion": "0.99.2",
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:pi-code-previews",
    "npm:@tintinweb/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/earendil-works/pi-review",
    "npm:@narumitw/pi-btw",
    "npm:@saccolabs/pi-claude-cli",
    "npm:pi-extmgr",
    "npm:pi-powerline-footer",
    "npm:pi-title"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "cache_read": {
      "format": "both"
