{
  "theme": "terminal",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode"
  ],
  "tuiMode": "fullscreen",
  "externalEditor": "druk",
  "skills": [
    "-~/.agents/skills/impeccable/SKILL.md"
  ],
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "steeringMode": "all",
  "followUpMode": "all",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "editorPaddingX": 1,
  "outputPad": 1,
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "packages": [
    "npm:pi-web-access@0.39.0",
    "npm:pi-code-previews@0.1.36",
    "npm:pi-powerline-footer@0.20.1",
    {
      "source": "npm:pi-title@0.1.8",
      "extensions": []
    },
    "git:github.com/michael-denyer/pstack-claude@7bad1ebc26faa268806bfbb84e5af55d178b68e4"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "queue",
        "context_pct",
        "cache_read",
        "cost"
      ]
    },
    "cache_read": {
      "format": "both"
    },
    "cost": {
      "subscriptionDisplay": "reported-cost",
      "currency": "GBP"
    }
  }
}
