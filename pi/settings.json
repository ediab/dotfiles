{
  "theme": "terminal",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode"
  ],
  "tuiMode": "fullscreen",
  "externalEditor": "druk",
  "skills": [],
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "steeringMode": "all",
  "followUpMode": "all",
  "quietStartup": true,
  "hideThinkingBlock": true,
  "editorPaddingX": 1,
  "outputPad": 1,
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "deviceId": "4867752c-ac6b-43a5-85b4-aeada0361eaf",
  "lastChangelogVersion": "1.0.2",
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:pi-code-previews",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/earendil-works/pi-review",
    "npm:@narumitw/pi-btw",
    "npm:@saccolabs/pi-claude-cli",
    "npm:pi-extmgr",
    "npm:pi-powerline-footer",
    "npm:pi-title",
    {
      "source": "npm:pi-subagents",
      "skills": [
        "skills/pi-subagents/**",
        "+skills/council-mode/SKILL.md"
      ],
      "prompts": [
        "+prompts/council.md",
        "+prompts/gather-context-and-clarify.md",
        "+prompts/parallel-cleanup.md",
        "+prompts/parallel-research.md",
        "+prompts/parallel-review.md",
        "+prompts/review-loop.md"
      ]
    },
    "npm:pi-contextimate"
  ],
  "subagents": {
    "disableBuiltins": true,
    "watchdog": {
      "enabled": false,
      "children": {
        "enabled": false
      }
    }
  },
  "powerline": {
    "preset": "default",
    "placement": "below",
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "queue",
        "context_pct",
        "cache_read",
        "cost"
      ]
    },
    "cache_read": {
      "format": "both"
    },
    "cost": {
      "subscriptionDisplay": "reported-cost",
      "currency": "GBP"
    }
  }
}