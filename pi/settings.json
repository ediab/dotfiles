{
  "theme": "terminal",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "tuiMode": "fullscreen",
  "externalEditor": "druk",
  "skills": [],
