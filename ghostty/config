# ============================================
# Ghostty Terminal - Configuration
# ============================================
# Reload: Cmd+Shift+, (macOS)
# View options: ghostty +show-config --default --docs

# --- Typography ---
font-family = "Maple Mono NF"
font-size = 13
font-thicken = true
adjust-cell-height = 10%

# --- Theme and Colors ---
theme = "Catppuccin Mocha"
window-colorspace = display-p3
minimum-contrast = 1.2

# --- Window and Appearance ---
window-decoration = auto
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = extend
window-save-state = always
window-inherit-working-directory = true
macos-option-as-alt = true
macos-titlebar-style = tabs
# For a chrome-less window instead: macos-titlebar-style = hidden + window-decoration = none + macos-window-buttons = hidden
resize-overlay = never

# --- Transparency ---
# NOTE: background-opacity needs a FULL Ghostty restart on macOS (reload_config won't apply it).
# Opacity is also disabled automatically in macOS native fullscreen.
background-opacity = 0.85
background-blur = macos-glass-regular
# Makes Neovim/tmux backgrounds respect background-opacity too (they're opaque by design otherwise).
background-opacity-cells = true

# --- Split Appearance ---
unfocused-split-opacity = 0.7
split-divider-color = #585b70
unfocused-split-fill = #181825

# --- Cursor ---
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.8

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = true

# --- Quick Terminal (Quake-style dropdown) ---
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- Security ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Behavior ---
confirm-close-surface = false

# --- Keybindings ---
# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick terminal global hotkey
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Splits management
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# Reload config
keybind = cmd+shift+comma=reload_config

# --- Performance ---
scrollback-limit = 25000000
