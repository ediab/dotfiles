<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.diab.dotfiles.capture</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>__DOTFILES_ROOT__/capture.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/.pi/agent/settings.json</string>
    <string>__HOME__/.pi/agent/open-tui.json</string>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/com.diab.dotfiles.capture.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.diab.dotfiles.capture.err</string>
</dict>
</plist>
