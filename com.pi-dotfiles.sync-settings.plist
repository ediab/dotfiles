<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- TEMPLATE: bootstrap.sh substitutes __PI_DOTFILES_REPO__ (repo path) and __PI_HOME__ ($HOME)
     before installing this into ~/Library/LaunchAgents/ — launchd does not expand ~, and
     hardcoding a path only works on a machine whose clone lives exactly there. -->
<dict>
	<key>Label</key>
	<string>com.pi-dotfiles.sync-settings</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PI_DOTFILES_REPO__/sync-settings.sh</string>
	</array>
	<key>WatchPaths</key>
	<array>
		<string>__PI_HOME__/.pi/agent/settings.json</string>
		<string>__PI_HOME__/.pi/agent/open-tui.json</string>
	</array>
	<key>StandardOutPath</key>
	<string>/tmp/com.pi-dotfiles.sync-settings.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/com.pi-dotfiles.sync-settings.err</string>
</dict>
</plist>
